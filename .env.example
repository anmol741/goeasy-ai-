# Copy to .env.local for local development, and set the same variables in
# your hosting dashboard. Never commit real values.

# Meta Pixel (optional)
NEXT_PUBLIC_META_PIXEL_ID=

# Contact form -> CRM webhook (required). Server-only: read in
# app/api/lead-webhook/route.ts. Never prefix with NEXT_PUBLIC_.
CRM_WEBHOOK_URL=your-crm-webhook-url-here

# Optional: if set, requests are signed with an X-Webhook-Signature (HMAC-SHA256) header
CRM_WEBHOOK_SECRET=optional-secret-here
